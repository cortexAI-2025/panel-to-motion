PORT=3000
# Repertoire de stockage durable (projets, medias, jobs)
DATA_DIR=./data
# Taille max des imports (Mo)
MAX_UPLOAD_MB=40
# Animation IA : 'replicate' ou 'off' (defaut : off, mouvement leger uniquement)
VIDEO_AI_PROVIDER=off
# Cle Replicate (uniquement si VIDEO_AI_PROVIDER=replicate)
REPLICATE_API_TOKEN=
REPLICATE_VIDEO_MODEL=stability-ai/stable-video-diffusion
